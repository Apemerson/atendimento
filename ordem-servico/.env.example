# PostgreSQL: use um banco dedicado (Supabase, Neon, Railway etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
# Gere uma chave forte e privada, por exemplo: openssl rand -base64 48
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE
PORT=3001
NODE_ENV=development

